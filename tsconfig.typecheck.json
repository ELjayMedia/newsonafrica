{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "config/**/*.ts",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "types/**/*.ts",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "middleware.ts",
    "middleware.test.ts",
    "codegen.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache/**",
    ".next/server/**",
    ".next/static/**",
    ".next/standalone/**",
    ".next/trace",
    "out",
    "coverage",
    "scripts/**",
    "@v0/scripts/**",
    "supabase/functions/**",
    "e2e/**",
    "playwright.config.ts"
  ]
}
