# =============================================================================
# News on Africa - Environment Variables
# Copy to .env.local and fill in real values. Validated by lib/env.ts (zod).
# NEXT_PUBLIC_* vars are exposed to the browser; all others are server-only.
# Supabase + WordPress vars are required (content integration, NOA-85..88).
# Paystack remains optional until the monetization phase lands.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical public base URL of this frontend (no trailing slash).
# Local: http://localhost:3000  Production: https://app.newsonafrica.com
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (content index, search, most-read) -------------------------------
# Project URL and public anon key (safe to expose with RLS configured).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only privileged key used by the content-sync DAL. NEVER expose to the
# browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Headless WordPress ---------------------------------------------------------
# Base URL of the WordPress multisite installation (no trailing slash). Each
# country edition is served from a subpath: `${WORDPRESS_API_URL}/<country>/wp-json/wp/v2`
# (REST) and `${WORDPRESS_API_URL}/<country>/graphql` (WPGraphQL).
WORDPRESS_API_URL=https://cms.example.com
# Optional explicit Nigeria endpoint overrides. If unset, the app falls back to
# `${WORDPRESS_API_URL}/ng/wp-json/wp/v2` and `${WORDPRESS_API_URL}/ng/graphql`.
NEXT_PUBLIC_WP_NG_REST_BASE=https://cms.example.com/ng/wp-json/wp/v2
NEXT_PUBLIC_WP_NG_GRAPHQL=https://cms.example.com/ng/graphql
# Optional auth header sent with every WordPress request, e.g. for a private
# staging instance: "Basic <base64(user:pass)>".
WORDPRESS_API_AUTH_HEADER=
# Optional per-request timeout override in milliseconds (default: 10000 dev / 20000 prod).
WORDPRESS_REQUEST_TIMEOUT_MS=
# Optional retry tuning for transient WP socket/timeout failures.
WORDPRESS_RETRY_ATTEMPTS=4
WORDPRESS_RETRY_BACKOFF_MS=750
# Shared secret WordPress must send (as `x-webhook-secret` or a signed
# `x-wp-signature`) to authorize the /api/webhooks/wordpress route.
WORDPRESS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Content sync admin routes (NOA-87) -----------------------------------------
# Shared secret required (as `x-content-sync-secret` or `Authorization: Bearer`)
# to call /api/admin/content-sync/{status,backfill}.
CONTENT_SYNC_SECRET=change-me-to-a-long-random-string

# --- Paystack (later phase) ---------------------------------------------------
# Public key for client-side checkout and secret key for server verification.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry -------------------------------------------------------------------
# Public DSN for eljaymedia-5k/newsonafrica. Leave blank to disable reporting.
NEXT_PUBLIC_SENTRY_DSN=
# Sensitive build credential for release and source-map upload.
SENTRY_AUTH_TOKEN=
